<h1>ログイン</h1>

<% if flash.now[:alert] %>
  <p><%= flash.now[:alert] %></p>
<% end %>

<%= form_with url: login_path do |form| %>
  <div>
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.submit "ログイン" %>
  </div>
<% end %>
