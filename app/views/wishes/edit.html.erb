<h1>やりたいことを編集</h1>

<%= form_with model: @wish do |form| %>
  <div>
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description, "説明" %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :category, "カテゴリー" %>
    <%= form.select :category, ["旅行", "学習", "仕事", "趣味", "欲しいもの", "挑戦", "その他"], prompt: "カテゴリーを選択してください" %>
  </div>

  <div>
    <%= form.label :completed, "達成済み" %>
    <%= form.check_box :completed %>
  </div>

  <div>
    <%= form.submit "更新する" %>
  </div>
<% end %>