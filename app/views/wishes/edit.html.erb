<div class="form-page">
  <div class="form-page__header">
    <h1 class="form-page__title">やりたいことを編集</h1>
    <p class="form-page__lead">内容や達成状況を更新できます。</p>
  </div>

  <div class="form-card">
    <% if @wish.errors.any? %>
      <div class="form-errors">
        <% @wish.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @wish, class: "wish-form" do |form| %>
      <div class="wish-form__group">
        <%= form.label :title, "タイトル", class: "wish-form__label" %>
        <%= form.text_field :title, class: "wish-form__input" %>
      </div>

      <div class="wish-form__group">
        <%= form.label :description, "説明", class: "wish-form__label" %>
        <%= form.text_area :description, class: "wish-form__textarea" %>
      </div>

      <div class="wish-form__group">
        <%= form.label :category, "カテゴリー", class: "wish-form__label" %>

        <%= form.select :category,
          ["旅行", "学習", "仕事", "趣味", "欲しいもの", "挑戦", "その他"],
          { prompt: "カテゴリーを選択してください" },
          class: "wish-form__select" %>
      </div>

      <div class="wish-form__group">
        <label class="wish-form__checkbox">
          <%= form.check_box :completed %>
          <span>達成済みにする</span>
        </label>
      </div>

      <div class="wish-form__actions">
        <%= form.submit "更新する", class: "wish-form__submit" %>
      </div>
    <% end %>
  </div>

  <div class="form-page__back">
    <%= link_to "← 詳細に戻る", wish_path(@wish) %>
  </div>
</div>