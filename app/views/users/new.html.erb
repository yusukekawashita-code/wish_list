<div class="form-page">
  <div class="form-page__header">
    <h1 class="form-page__title">ユーザー登録</h1>
    <p class="form-page__lead">Wish Listをはじめましょう。</p>
  </div>

  <div class="form-card">
    <% if @user.errors.any? %>
      <div class="form-errors">
        <% @user.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @user, class: "wish-form" do |form| %>
      <div class="wish-form__group">
        <%= form.label :name, "名前", class: "wish-form__label" %>
        <%= form.text_field :name, class: "wish-form__input" %>
      </div>

      <div class="wish-form__group">
        <%= form.label :email, "メールアドレス", class: "wish-form__label" %>
        <%= form.email_field :email, class: "wish-form__input" %>
      </div>

      <div class="wish-form__group">
        <%= form.label :password, "パスワード", class: "wish-form__label" %>
        <%= form.password_field :password, class: "wish-form__input" %>
      </div>

      <div class="wish-form__group">
        <%= form.label :password_confirmation, "パスワード確認", class: "wish-form__label" %>
        <%= form.password_field :password_confirmation, class: "wish-form__input" %>
      </div>

      <div class="wish-form__actions">
        <%= form.submit "登録する", class: "wish-form__submit" %>
      </div>
    <% end %>
  </div>

  <div class="form-page__back">
    <%= link_to "すでにアカウントをお持ちの方はこちら", login_path %>
  </div>
</div>